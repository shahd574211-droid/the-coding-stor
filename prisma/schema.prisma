// Stor AI — E-commerce Platform
// Prisma schema for Supabase PostgreSQL
// Phase 2: Database Schema
//
// Indexes: مراجعة docs/PERFORMANCE.md — الفهارس المركبة لتسريع الاستعلامات الشائعة.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ——— Auth & Users ———

model User {
  id             String    @id @default(cuid())
  phone          String    @unique // E.164 format
  phoneNormalized String   @unique @map("phone_normalized") // normalized for lookups
  supabaseUserId String?   @unique @map("supabase_user_id") // link to Supabase Auth
  encryptedSupabasePassword String? @map("encrypted_supabase_password") @db.VarChar(500) // server-only; for session recovery after OTP
  name           String?   @db.VarChar(255)
  email          String?   @db.VarChar(255)
  avatarUrl      String?   @map("avatar_url") @db.VarChar(500)
  role           UserRole  @default(USER)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  orders    Order[]
  sessions  Session[]
  admin     Admin?
  cartItems CartItem[]

  @@map("users")
}

enum UserRole {
  USER
  ADMIN
}

model OTP {
  id        String   @id @default(cuid())
  phone     String   @db.VarChar(20)
  otpHash   String   @map("otp_hash") @db.VarChar(255) // hashed 6-digit OTP
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([phone, expiresAt])
  @@index([phone])
  @@index([phone, createdAt])
  @@map("otps")
}

model Session {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  supabaseRefreshTokenHash String? @map("supabase_refresh_token_hash") @db.VarChar(255)
  expiresAt    DateTime @map("expires_at")
  userAgent    String?  @map("user_agent") @db.VarChar(500)
  ipAddress    String?  @map("ip_address") @db.VarChar(45)
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Admin {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  role      AdminRole @default(ADMIN)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admins")
}

enum AdminRole {
  ADMIN
  SUPER_ADMIN
}

// ——— Catalog ———

model Category {
  id          String    @id @default(cuid())
  name        String    @db.VarChar(255)
  slug        String    @unique @db.VarChar(255)
  description String?   @db.Text
  imageUrl    String?   @map("image_url") @db.VarChar(500)
  parentId    String?   @map("parent_id")
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryHierarchy")
  products Product[]

  @@index([slug])
  @@index([parentId])
  @@index([parentId, sortOrder])
  @@map("categories")
}

model Product {
  id          String       @id @default(cuid())
  categoryId  String?      @map("category_id")
  name        String       @db.VarChar(255)
  slug        String       @unique @db.VarChar(255)
  description String?      @db.Text
  shortDescription String?  @map("short_description") @db.VarChar(500)
  price       Decimal     @db.Decimal(12, 2)
  compareAtPrice Decimal?  @map("compare_at_price") @db.Decimal(12, 2)
  currency    String      @default("USD") @db.VarChar(3)
  type        ProductType @default(PHYSICAL)
  published   Boolean     @default(false)
  stock       Int?        // null = unlimited or digital
  imageUrl    String?     @map("image_url") @db.VarChar(500)
  images      String[]    @default([]) // Supabase Storage paths or URLs
  metadata    Json?       // flexible attributes (e.g. file type, duration for courses)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  category      Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  digitalAssets DigitalAsset[]
  orderItems    OrderItem[]
  cartItems     CartItem[]

  @@index([slug])
  @@index([categoryId])
  @@index([type, published])
  @@index([published, createdAt])
  @@index([published, categoryId])
  @@map("products")
}

enum ProductType {
  DIGITAL
  PHYSICAL
}

model DigitalAsset {
  id              String   @id @default(cuid())
  productId       String   @map("product_id")
  filePath        String   @map("file_path") @db.VarChar(500) // Supabase Storage path
  fileName        String   @map("file_name") @db.VarChar(255)
  mimeType        String   @map("mime_type") @db.VarChar(100)
  sizeBytes       BigInt   @map("size_bytes")
  downloadExpiresInHours Int @default(24) @map("download_expires_in_hours")
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at")

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[] // which order items include this asset (for multi-file products)

  @@index([productId])
  @@map("digital_assets")
}

// ——— Orders ———

model Order {
  id              String      @id @default(cuid())
  userId          String      @map("user_id")
  status          OrderStatus @default(PENDING)
  total           Decimal     @db.Decimal(12, 2)
  currency        String      @default("USD") @db.VarChar(3)
  subtotal        Decimal     @db.Decimal(12, 2)
  tax             Decimal?    @db.Decimal(12, 2)
  shippingCost    Decimal?    @map("shipping_cost") @db.Decimal(12, 2)
  shippingAddress Json?       @map("shipping_address") // { address, city, country, postalCode, phone }
  paidAt          DateTime?   @map("paid_at")
  deliveredAt     DateTime?   @map("delivered_at")
  completedAt     DateTime?   @map("completed_at")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("orders")
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  DELIVERED
  COMPLETED
  CANCELLED
  REFUNDED
}

model OrderItem {
  id             String   @id @default(cuid())
  orderId        String   @map("order_id")
  productId      String   @map("product_id")
  digitalAssetId String?  @map("digital_asset_id") // optional: specific asset for this line (e.g. multi-file product)
  quantity       Int      @default(1)
  priceAtPurchase Decimal @map("price_at_purchase") @db.Decimal(12, 2)
  createdAt      DateTime @default(now()) @map("created_at")

  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  digitalAsset  DigitalAsset? @relation(fields: [digitalAssetId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

// ——— Cart (server-side or hybrid) ———

model CartItem {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  productId String   @map("product_id")
  quantity  Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@map("cart_items")
}
