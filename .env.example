# Supabase (required for auth + optional DB) — get from https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# Supabase Storage bucket (product/category images) — create bucket in Dashboard → Storage, set to Public
BACKEND_NAME="your-bucket-name"
SECRET_KEY_STOREG="your-service-role-key-or-storage-secret"

# Database (Prisma) — use Supabase connection string from Project Settings → Database
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?pgbouncer=true"

# UltraMsg WhatsApp API (OTP)
ULTRAMSG_INSTANCE_ID="your-instance-id"
ULTRAMSG_TOKEN="your-token"

# Auth (OTP hash + encrypted Supabase password storage)
OTP_HASH_SECRET="random-secret-at-least-32-chars"
ENCRYPTION_KEY="random-secret-at-least-32-chars"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
